[colors]
# Тот самый синий цвет BIOS для фона панели
background = #00009c
# Серый цвет BIOS для обычного текста
foreground = #a8a8a8
# Белый цвет BIOS для активных элементов (выбранный воркспейс, важный статус)
foreground-active = #ffffff
# Черный для контрастных элементов разметки
black = #000000

[bar/bios]
width = 100%
height = 24pt
radius = 0

background = ${colors.background}
foreground = ${colors.foreground}

# Убираем любые рамки и отступы операционной системы
border-size = 0
padding-left = 2
padding-right = 2
module-margin = 2

font-0 = "PxPlus IBM VGA 9x16:size=15;4"

# Расположение модулей: слева ворксейсы (как вкладки меню Main/Advanced), 
# по центру заголовок утилиты, справа — системные часы и статус
modules-left = xworkspaces
modules-center = bios-title
modules-right = filesystem pulseaudio memory cpu date

cursor-click = pointer
cursor-scroll = ns-resize

enable-ipc = true

[module/xworkspaces]
type = internal/xworkspaces

# Неактивные рабочие столы (как невыбранные пункты меню BIOS)
label-active = %name%
label-active-foreground = ${colors.foreground-active}
label-active-background = ${colors.black}
label-active-padding = 2

label-occupied = %name%
label-occupied-padding = 2
label-occupied-foreground = ${colors.foreground}

label-urgent = %name%
label-urgent-background = #a80000
label-urgent-padding = 2

label-empty = %name%
label-empty-foreground = #545454
label-empty-padding = 2

[module/bios-title]
type = internal/xwindow
# Текст по центру экрана в стиле утилиты Aptio Setup Utility
label = "Aptio Setup Utility - %title%"
label-maxlen = 50
label-foreground = ${colors.foreground-active}

[module/filesystem]
type = internal/filesystem
interval = 25
mount-0 = /
label-mounted = "DISK: %percentage_used%%"

[module/pulseaudio]
type = internal/pulseaudio
format-volume-prefix = "AUDIO: "
format-volume = <label-volume>
label-volume = %percentage%%
label-muted = "AUDIO: MUTE"
label-muted-foreground = #545454

[module/memory]
type = internal/memory
interval = 3
label = "RAM: %percentage_used%%"

[module/cpu]
type = internal/cpu
interval = 3
label = "CPU: %percentage%%"

[module/date]
type = internal/date
interval = 1
# Формат даты и времени, близкий к системным часам BIOS
date = "[%Y/%m/%d]  %H:%M:%S"
label = %date%
label-foreground = ${colors.foreground-active}


[bar/bios-bottom]
# Размещаем панель в самом низу экрана
bottom = true
width = 100%
height = 20pt
radius = 0

background = ${colors.background}
foreground = ${colors.foreground}

border-size = 0
padding-left = 4
padding-right = 4
module-margin = 4

font-0 = "PxPlus IBM VGA 9x16:size=15;2`"

# Выводим подсказки слева, по центру и справа, как в настоящей утилите
modules-left = bios-help-left
modules-center = bios-help-center
modules-right = bios-version

# Отключаем интерактивность, это просто статус-панель
cursor-click = default
cursor-scroll = default
enable-ipc = true

# --- Определение текстовых модулей-подсказок ---

[module/bios-help-left]
type = custom/text
# Подсказки по управлению i3wm в стиле BIOS
format = "→←: Select Screen   ↑↓: Select Item   Enter: Launch"
format-foreground = ${colors.foreground}

[module/bios-help-center]
type = custom/text
# Горячие клавиши для закрытия окон и перезапуска
format = "Mod+Q: Kill Window   Mod+Shift+R: Reset"
format-foreground = ${colors.foreground}

[module/bios-version]
type = custom/text
format = "Version 2.14.1219. Copyright (C) 2026 Linux OS"
format-foreground = ${colors.foreground-active}

[settings]
screenchange-reload = true
pseudo-transparency = false
